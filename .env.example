# Copy to .env.local and fill in. Never commit real values.
#
# Every value below is a DUMMY placeholder that only shows the format. Replace each one with your own before using it.
# Make a real secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional integrations are switched off while their keys are blank or invalid: delete the dummy value to turn one off cleanly.

# ── Database (required) ────────────────────────────────
# MongoDB is where all user data is saved (accounts, banks, funds, budgets, goals, the encrypted vault, ...),
# so the same account works on every phone and laptop. The app does not start without it.
# Local:  mongodb://localhost:27017/mintmind
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mintmind?retryWrites=true&w=majority
# Back this database up. Vault items in it are encrypted in the browser, so a lost master password and recovery key cannot be reset.
MONGODB_URI=mongodb://localhost:27017/mintmind

# ── Core ───────────────────────────────────────────────
JWT_SECRET=dummy-jwt-secret-replace-with-64-random-hex-characters-0000000000000000   # required in production
ENCRYPTION_KEY=dummy-encryption-key-replace-with-32-plus-random-characters-1234      # 32+ random chars, encrypts stored tokens
APP_URL=http://localhost:3000                   # public URL; used to build OAuth callback URLs and password-reset links
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true                      # true shows the "sample family" demo
CRON_SECRET=dummy-cron-secret-replace-me-0000000000000000                            # protects scheduled/cron endpoints

# ── Google sign-in + Google Drive documents ────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI for Drive:  {APP_URL}/api/drive/callback
# Enable the Google Drive API. Scope used: drive.file (only files this app creates).
GOOGLE_CLIENT_ID=000000000000-dummyclientid0000000000000000.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-dummy-client-secret-0000000000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-dummyclientid0000000000000000.apps.googleusercontent.com

# ── Fund NAVs ──────────────────────────────────────────
# Latest NAVs and fund search come from the free public API https://www.mfapi.in (no key, no setup). Each fund is looked up at most once a day.

# ── AI assistant (optional; the app works without it) ──
AI_PROVIDER=none                                # none | anthropic | openai
AI_API_KEY=dummy-ai-api-key-replace-me          # or ANTHROPIC_API_KEY / OPENAI_API_KEY; ignored while AI_PROVIDER=none
# ANTHROPIC_API_KEY=sk-ant-dummy-0000000000000000
# OPENAI_API_KEY=sk-dummy-0000000000000000
# AI_MODEL=
# AI_BASE_URL=
# AI_MAX_TOKENS=1024
# AI_TIMEOUT_MS=30000
# AI_DAILY_LIMIT=50

# ── Email / SMS (optional) ─────────────────────────────
# Email sends password-reset links, family invitations and Digital Legacy reminders. Without it no email is sent
# (in development the reset link is printed in the server log instead).
RESEND_API_KEY=re_dummy_0000000000000000000000000
RESEND_FROM=Mintmind <no-reply@example.com>
SMS_PROVIDER=twilio                             # twilio, or leave blank for no SMS
TWILIO_ACCOUNT_SID=ACdummy00000000000000000000000000
TWILIO_AUTH_TOKEN=dummy0000000000000000000000000000
TWILIO_FROM=+15550000000
LEGACY_NOTIFY_WEBHOOK=https://example.com/hooks/mintmind-legacy

# ── Uploads (optional) ─────────────────────────────────
UPLOAD_DIR=./storage
UPLOAD_MAX_BYTES=5242880
