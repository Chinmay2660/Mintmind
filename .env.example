# Copy to .env.local and fill in. Never commit real values.

# ── Core ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/mintmind
JWT_SECRET=change-me-long-random-string        # required in production
ENCRYPTION_KEY=                                 # 32+ random chars, encrypts stored tokens
APP_URL=http://localhost:3000                   # public URL; used to build OAuth callback URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true                      # true shows the "sample family" demo
CRON_SECRET=                                    # protects scheduled/cron endpoints

# ── Google sign-in + Google Drive documents ────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI for Drive:  {APP_URL}/api/drive/callback
# Enable the Google Drive API. Scope used: drive.file (only files this app creates).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Weekly NAV / price sync (internal) ─────────────────
# Schedule weekly:  GET {APP_URL}/api/internal/market-sync   Authorization: Bearer $CRON_SECRET
# AMFI's public NAV file is used with no setup. Zerodha Kite is optional and adds the MF list + equity prices.
# Kite app redirect URL:  {APP_URL}/api/internal/kite/callback
# Owner signs in on the sync day (token lasts one day):  {APP_URL}/api/internal/kite/login?key=$CRON_SECRET
KITE_API_KEY=
KITE_API_SECRET=
MARKET_EQUITY_SYMBOLS=                          # e.g. NSE:NIFTYBEES,NSE:RELIANCE

# ── AI assistant (optional; the app works without it) ──
AI_PROVIDER=none                                # none | anthropic | openai
AI_API_KEY=                                     # or ANTHROPIC_API_KEY / OPENAI_API_KEY
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
# AI_MAX_TOKENS=1024
# AI_TIMEOUT_MS=30000
# AI_DAILY_LIMIT=50

# ── Email / SMS (optional) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
SMS_PROVIDER=
LEGACY_NOTIFY_WEBHOOK=

# ── Uploads (optional) ─────────────────────────────────
UPLOAD_DIR=./storage
UPLOAD_MAX_BYTES=5242880
